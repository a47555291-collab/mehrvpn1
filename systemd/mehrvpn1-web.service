[Unit]
Description=MehrVPN1 Web
After=network.target mehrvpn1-agent.service
[Service]
User=mehrvpn
Group=mehrvpn
WorkingDirectory=/opt/mehrvpn1
Environment=MEHRVPN_DATA_DIR=/var/lib/mehrvpn1
ExecStart=/opt/mehrvpn1/.venv/bin/uvicorn panel.app:app --uds /run/mehrvpn1/web.sock
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mehrvpn1 /run/mehrvpn1
[Install]
WantedBy=multi-user.target
